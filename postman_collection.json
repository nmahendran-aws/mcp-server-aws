                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Accept",
                        "value": "application/json, text/event-stream",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"subtract\",\n    \"arguments\": {\n      \"a\": 10,\n      \"b\": 4\n    }\n  },\n  \"id\": 3\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "http://localhost:3001/mcp",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3001",
                    "path": [
                        "mcp"
                    ]
                },
                "description": "Calls the subtract tool to subtract two numbers"
            }
        },
        {
            "name": "Greeting Tool",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Accept",
                        "value": "application/json, text/event-stream",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"greetingPrompt\",\n    \"arguments\": {\n      \"name\": \"John\"\n    }\n  },\n  \"id\": 4\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
